# Leave empty in production: vercel.json rewrites /api/* to the Render API (keeps the auth cookie first-party).
# Set only if the browser should call the API directly, e.g. https://squadsync-api.onrender.com
VITE_API_URL=

# Firebase web app config (Project settings > General > Your apps > Web app)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Project settings > Cloud Messaging > Web Push certificates > Key pair
VITE_FIREBASE_VAPID_KEY=
