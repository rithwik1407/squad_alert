# ─────────────────────────────────────────────────────────────
# SquadSync server + worker env. Copy to .env (repo root) for local dev.
# On Render (free plan) everything runs in one web service; see render.yaml.
# ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# MongoDB Atlas connection string (Database > Connect > Drivers)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/squadsync?retryWrites=true&w=majority

# DNS servers used to resolve mongodb+srv:// (fixes "querySrv ECONNREFUSED" on some ISPs/Windows).
# Default 8.8.8.8,1.1.1.1. Set to "off" to use your system DNS.
MONGO_DNS_SERVERS=8.8.8.8,1.1.1.1

# Upstash Redis: use the "rediss://" TCP URL (not the REST URL)
REDIS_URL=rediss://default:<password>@<host>.upstash.io:6379

# Long random string: `openssl rand -hex 32`
JWT_SECRET=change-me
JWT_EXPIRES_IN=30d

# Where the React app lives (used for CORS and links inside notifications)
CLIENT_URL=http://localhost:5173
# Extra allowed origins, comma separated (e.g. Vercel preview URLs)
CORS_ORIGINS=
# lax when the client proxies /api via Vercel rewrites (recommended); none if the browser calls Render directly
COOKIE_SAMESITE=lax

DISPLAY_TZ=Asia/Kolkata
QUEUE_NAME=match-notify
# true = run the notification worker inside the API process (single free Render service).
# RUN_WORKER_INLINE=true does the same.
RUN_WORKER_IN_API=false
# Minutes after a match starts that a late alert (missed while the server slept) is still sent
CATCHUP_GRACE_MIN=10

# Firebase Admin (Project settings > Service accounts > Generate new private key)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the key on one line with literal \n for newlines, wrapped in double quotes
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Telegram bot from @BotFather
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Any random string; also passed to setWebhook as secret_token
TELEGRAM_WEBHOOK_SECRET=

# Nightly Telegram team summary at 12:00 AM (DISPLAY_TZ). On by default; set to false to turn it off.
DAILY_SUMMARY_ENABLED=true
# Optional: any random string. Enables GET /api/cron/daily-summary?key=... for cron-job.org (backup trigger + preview).
CRON_SECRET=

# WhatsApp Cloud API (Meta): main alert channel. developers.facebook.com > your app > WhatsApp > API Setup
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
# Approved Utility template with 4 body variables: {{1}} match, {{2}} map, {{3}} time, {{4}} room/pass.
# Leave empty to use Meta's hello_world template (fixed text) + a best-effort text with the details.
WHATSAPP_TEMPLATE_NAME=
# Language code of your template (e.g. en, en_US). Defaults to en_US for hello_world, en otherwise.
WHATSAPP_TEMPLATE_LANG=
# Channel order. Default: whatsapp,fcm,telegram
NOTIFY_ORDER=


# Optional: lets the admin upload a BGMI results screenshot and have kills/damage read automatically.
# Free: Google Gemini key from https://aistudio.google.com/apikey (used first when set).
GEMINI_API_KEY=
# More free readers, tried in this order after Gemini when it's busy or out of free uses:
# Groq: https://console.groq.com/keys   OpenRouter: https://openrouter.ai/keys
GROQ_API_KEY=
OPENROUTER_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash   (optional: force one model; empty = pick automatically)
# Paid alternative: Claude key from https://console.anthropic.com. Without either key, type the numbers in by hand.
ANTHROPIC_API_KEY=

# WhatsApp alerts are switched off for now. Set to true (and VITE_WHATSAPP_ENABLED=true on Vercel) to bring them back.
WHATSAPP_ENABLED=false
